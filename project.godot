; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LunarLanderCorps"
config/name_localized={
"en": "Lunar Lander Corps"
}
config/description="A 3D Lunar Lander clone. You are a member of a group of curious sentient robots living in a system of dozens of moons orbiting a gas giant. Help deliver supplies between landing pads on the latest target of the research corps. Earn points based on your landing, upgrade your lander, and blow up in spectacular fashion when you miss the pad. Don't worry, we saved a backup of your program."
config/version="0.0.1"
run/main_scene="uid://8mak8po6ocns"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false
config/icon="uid://dyx7441bk14sw"

[autoload]

Util="*res://scripts/utils/util.gd"
SceneChanger="*res://scenes/utils/scene_changer.tscn"
Signals="*res://scripts/utils/signals.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/size/resizable=false

[global_group]

lander=""
cam=""
game_events=""
terrain_gen=""
landing_pads=""
mission_gen=""

[gui]

theme/custom="uid://b0f1g2k7xxm12"
theme/custom_font="uid://sx2fcvd377a2"

